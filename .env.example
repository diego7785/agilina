# ============================================================================
# Agilina — environment variables
# Copy to .env with `make env` and fill in. The .env is NEVER versioned.
# No real value lives in this file: only the expected keys.
# Wrap in single quotes any value with $, quotes or backticks: the Makefile
# reads this file with bash and would expand them.
# ============================================================================

# ------------------------------------------------------------ Environment ---
AGILINA_ENVIRONMENT=local      # local | cloud
AGILINA_LOG_LEVEL=INFO         # DEBUG | INFO | WARNING | ERROR
AGILINA_DEFAULT_LANGUAGE=es    # es | en

# --------------------------------------------------------------- Postgres ---
POSTGRES_USER=agilina
POSTGRES_PASSWORD=
POSTGRES_DB=agilina
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# One PostgreSQL server, several databases (AD-29): the platform's catalog of tenants
# (AGILINA_PLATFORM_DB) and one per tenant, named AGILINA_TENANT_DB_PREFIX plus its slug
# (agilina_acme). POSTGRES_DB is only the database the server always has, the one the others
# are created from.
AGILINA_PLATFORM_DB=agilina_platform
AGILINA_TENANT_DB_PREFIX=agilina_

# --------------------------------------------------------------- pgAdmin ----
# Web client for the database: http://localhost:5051. Its own account (not Postgres').
# The email must have a valid format: addresses ending in .local are rejected.
PGADMIN_ADMIN_EMAIL=admin@example.com
PGADMIN_ADMIN_PASSWORD=
PGADMIN_PORT=5051

# ------------------------------------------------------------------- API ----
AGILINA_API_HOST=127.0.0.1
AGILINA_API_PORT=8000
AGILINA_API_PUBLIC_URL=http://localhost:8000
# Where people open the web application: the invitation e-mail links to <this>/activate.
AGILINA_WEB_PUBLIC_URL=http://localhost:4200
AGILINA_ALLOWED_ORIGINS=http://localhost:4200

# -------------------------------------------------------------- Keycloak ----
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
# The URL the browser reaches Keycloak at, and so the issuer of every token it signs: the API
# only accepts tokens issued by it (Compose reads Keycloak's keys through its own network).
AGILINA_KEYCLOAK_URL=http://localhost:8080
# One realm per tenant (AD-29): its name is this prefix and the tenant's slug (agilina-acme).
AGILINA_TENANT_REALM_PREFIX=agilina-
AGILINA_KEYCLOAK_WEB_CLIENT=agilina-web
AGILINA_KEYCLOAK_WORKER_CLIENT=agilina-worker
# Secret of the API's own client in each tenant's realm (it creates accounts when an invitation
# is accepted): one per tenant, AGILINA_TENANT_<SLUG>_KEYCLOAK_API_SECRET. `make env` generates
# the ones of the development tenants and `make tenant-add` the one of a new tenant.
AGILINA_TENANT_ACME_KEYCLOAK_API_SECRET=
AGILINA_TENANT_ECOMODA_KEYCLOAK_API_SECRET=
# Secret of the agent worker's client (agilina-worker) in each tenant's realm, the same way:
# one per tenant, AGILINA_TENANT_<SLUG>_KEYCLOAK_WORKER_SECRET, generated by `make env` and
# `make tenant-add`. The worker signs in with it (client credentials) to call the API.
AGILINA_TENANT_ACME_KEYCLOAK_WORKER_SECRET=
AGILINA_TENANT_ECOMODA_KEYCLOAK_WORKER_SECRET=
# Where the worker keeps the results the API has not accepted yet, one file per ceremony in
# <dir>/<tenant>/<ceremony_id>.json, removed when the API answers 202. Empty means
# infra/datos/agent-pending, which git ignores.
AGILINA_AGENT_PENDING_DIR=

# ----------------------------------------------------------------- Email ----
# Which server delivers the email is only configuration (AD-23). By default it is
# Mailpit, the development inbox: http://localhost:8025. Nothing leaves the machine.
AGILINA_SMTP_HOST=mailpit
AGILINA_SMTP_PORT=1025
AGILINA_SMTP_USER=
AGILINA_SMTP_PASSWORD=
AGILINA_SMTP_SECURITY=none       # none | starttls | tls
AGILINA_MAIL_FROM='Agilina <no-reply@agilina.local>'
# To use Amazon SES instead (sandbox), see docs/entorno-local.md, section "Correo":
#   AGILINA_SMTP_HOST=email-smtp.<region>.amazonaws.com
#   AGILINA_SMTP_PORT=587
#   AGILINA_SMTP_USER=<SMTP username created in the SES console, not your AWS login>
#   AGILINA_SMTP_PASSWORD=<SMTP password created in the SES console>
#   AGILINA_SMTP_SECURITY=starttls
#   AGILINA_MAIL_FROM='Agilina <an-address-verified-in-SES>'
# Then check it with: make mail-test to=<a verified address>

# --------------------------------------------------------------- LiveKit ----
# The agent joins the rooms with these keys, and the API uses them too: it opens the
# room of each daily and signs the token of every participant (AGI-59).
AGILINA_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
AGILINA_LIVEKIT_API_KEY=
AGILINA_LIVEKIT_API_SECRET=

# ----------------------------------------------- Transcription service ------
AGILINA_STT_URL=http://localhost:8001
AGILINA_STT_MODEL=small
AGILINA_STT_DEVICE=cpu           # cpu | cuda
AGILINA_STT_COMPUTE_TYPE=int8    # int8 | float16
AGILINA_STT_SIMULATED=true       # true locally without a GPU: returns test text

# -------------------------------------------------------------- ElevenLabs --
AGILINA_ELEVENLABS_API_KEY=
AGILINA_ELEVENLABS_VOICE_ES=
AGILINA_ELEVENLABS_VOICE_EN=

# ------------------------------------------------------------------ Gemini --
AGILINA_GEMINI_API_KEY=
AGILINA_GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------- Integrations (from Release 2) -----
# They are stored per team in the database; these are only the credentials of
# the application registered with each provider.
AGILINA_SLACK_CLIENT_ID=
AGILINA_SLACK_CLIENT_SECRET=
AGILINA_SLACK_SIGNING_SECRET=
AGILINA_JIRA_CLIENT_ID=
AGILINA_JIRA_CLIENT_SECRET=
AGILINA_MS_CLIENT_ID=
AGILINA_MS_CLIENT_SECRET=
AGILINA_MS_TENANT_ID=
